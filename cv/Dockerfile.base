# pump-cv runtime base image — heavy deps only.
#
# This is everything pump-cv needs to run *except* the pump-cv source
# itself. Splitting it out means a code-only change in cv/pump_cv/...
# rebuilds the runtime image in well under a minute — the heavy layers
# (CUDA, torch, ultralytics, opencv) are pulled from this base instead
# of redownloaded from PyPI on every tag bump.
#
# Tagged by:
#   - the git SHA that built it (immutable, stable for runtime pins)
#   - :latest (mutable, points at HEAD's most recent build)
#
# Triggered by `.github/workflows/cv-base-publish.yml`, which re-runs
# whenever cv/Dockerfile.base or cv/pyproject.toml's dependency list
# changes. Manual rebuilds are available via that workflow's
# workflow_dispatch trigger.
#
# Base image notes:
#   - `nvcr.io/nvidia/pytorch:25.04-py3` is multi-arch (linux/amd64 +
#     linux/arm64) and ships PyTorch 2.7 + CUDA 12.9 with
#     TORCH_CUDA_ARCH_LIST covering Blackwell (sm_120 / GB10 / Spark).
#     This replaces the prior nvidia/cuda:12.4.1 + cu121 wheel approach,
#     which was amd64-only — pytorch.org's cu* wheel channels don't
#     publish aarch64.
#   - Trade-off: dropping cu121 also drops Pascal (sm_61 / P40)
#     compatibility. The cu121 pin was kept specifically so the P40 stayed
#     supported; the move to the nvcr.io stack starts at Volta (sm_70) and
#     is the right call now that pump-cv is moving to the Spark/GB10 node.
#   - Image is large (~10 GB) but heavy layers stay in the ZOT pull-through
#     cache; code-only tag bumps still ship in ~1 min via the runtime image.
FROM nvcr.io/nvidia/pytorch:25.04-py3

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Runtime deps the nvcr.io base doesn't already ship: ffmpeg (video I/O),
# libgl1 + libglib2.0-0 (OpenCV runtime). Python + pip + torch are
# pre-installed in the base.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libgl1 \
        libglib2.0-0

WORKDIR /app
COPY pyproject.toml ./

# Install everything pump-cv depends on, but not pump-cv itself
# (the source is layered in by the runtime Dockerfile).
#
# The nvcr.io base ships torch + torchvision pre-built for both arches
# already; ultralytics and the other deps declare torch>=X and pip's
# resolver accepts the base's pre-installed torch (no --upgrade flag,
# no version bump triggered).
#
# pip cache mount preserves wheel downloads across base rebuilds.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip tomli \
    && python3 -c "import tomli; deps = tomli.load(open('pyproject.toml','rb'))['project']['dependencies']; open('/tmp/req.txt','w').write('\n'.join(deps))" \
    && pip install -r /tmp/req.txt \
    && rm /tmp/req.txt

# Diagnostic: print the compiled arch list so a future regression is
# visible in build logs. With the nvcr.io base on 25.04, expect sm_70
# through sm_120 (Volta through Blackwell). Pascal (sm_61) is not
# expected — see the Trade-off note in the base image comments above.
RUN python3 -c "import torch; print('torch:', torch.__version__, 'archs:', torch.cuda.get_arch_list())"
