FROM golang:alpine AS builder

ARG VERSION=dev

RUN apk add --no-cache build-base
COPY . /src
RUN cd /src && CGO_ENABLED=0 go build \
    -ldflags "-X github.com/rwlove/PUMP/internal/web.Version=${VERSION}" \
    -o /pump ./cmd/pump

FROM scratch

WORKDIR /data/PUMP
WORKDIR /app

COPY --from=builder /pump /app/

ENTRYPOINT ["./pump"]
