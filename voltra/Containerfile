# Single stage: unlike pump-cv there is no GPU stack here, so the whole image
# is small enough that the split base/runtime build buys nothing.
# Pinned to 3.14: the ESPHome BLE stack's transitive dep `lru-dict` ships no
# cp315 wheel yet and won't compile against 3.15's C API in a -slim image (no
# toolchain), so 3.15 breaks `pip install .`. 3.14 is the last base this image
# built on (pump-voltra-v0.1.17). Renovate is held at the python base below;
# revert both when lru-dict publishes cp315 wheels.
FROM python:3.14-slim

WORKDIR /app

COPY pyproject.toml ./
COPY pump_voltra ./pump_voltra
COPY configs ./configs

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir .

ENV PUMP_VOLTRA_CONFIG=/app/configs/default.yaml

# The trainer accepts a single BLE central, so this must run one replica with
# a Recreate strategy — two would fight over the connection.
EXPOSE 8080

ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="pump-voltra" \
      org.opencontainers.image.description="PUMP Voltra trainer sidecar (BLE telemetry → PUMP sets, motor control)" \
      org.opencontainers.image.source="https://github.com/rwlove/PUMP" \
      org.opencontainers.image.url="https://github.com/rwlove/PUMP" \
      org.opencontainers.image.documentation="https://github.com/rwlove/PUMP/blob/main/voltra/README.md" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

ENTRYPOINT ["python", "-m", "pump_voltra.main"]
